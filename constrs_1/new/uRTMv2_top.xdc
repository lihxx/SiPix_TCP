# uRTMv2 xc7k325tffg900-2
# Version 2022-05-28
set_property BITSTREAM.CONFIG.SPI_BUSWIDTH 4 [current_design]

######################################################################
# Reset
set_property PACKAGE_PIN R23 [get_ports RST_B]
set_property IOSTANDARD LVCMOS33 [get_ports RST_B]

######################################################################
# Clock
create_clock -period 5.000 -name REFCLK [get_ports CLK_IN_200_P]
set_property IOSTANDARD LVDS_25 [get_ports CLK_IN_200_P]
set_property PACKAGE_PIN D17 [get_ports CLK_IN_200_P]
set_property PACKAGE_PIN D18 [get_ports CLK_IN_200_N]
set_property IOSTANDARD LVDS_25 [get_ports CLK_IN_200_N]

#create_clock  -period 25.0 -name PLLCLK [get_ports "CLK_IN_PL_P"]
#set_property  PACKAGE_PIN AG29          [get_ports "CLK_IN_PL_P"]
#set_property  IOSTANDARD  LVDS_25       [get_ports "CLK_IN_PL_P"]
#set_property  PACKAGE_PIN AH29          [get_ports "CLK_IN_PL_N"]
#set_property  IOSTANDARD  LVDS_25       [get_ports "CLK_IN_PL_N"]

#create_clock  -period 8.0 -name SWCLK   [get_ports "CLK_IN_SW_P"]
#set_property  PACKAGE_PIN AG10          [get_ports "CLK_IN_SW_P"]
#set_property  IOSTANDARD  DIFF_SSTL135  [get_ports "CLK_IN_SW_P"]
#set_property  PACKAGE_PIN AH10          [get_ports "CLK_IN_SW_N"]
#set_property  IOSTANDARD  DIFF_SSTL135  [get_ports "CLK_IN_SW_N"]


######################################################################
# I/O
set_property  PACKAGE_PIN AB12          [get_ports "DIPSW[0]"]
set_property  IOSTANDARD  SSTL135       [get_ports "DIPSW[0]"]
set_property  PULLUP      true          [get_ports "DIPSW[0]"]
set_property  PACKAGE_PIN AA12          [get_ports "DIPSW[1]"]
set_property  IOSTANDARD  SSTL135       [get_ports "DIPSW[1]"]
set_property  PULLUP      true          [get_ports "DIPSW[1]"]
set_property  PACKAGE_PIN Y11           [get_ports "DIPSW[2]"]
set_property  IOSTANDARD  SSTL135       [get_ports "DIPSW[2]"]
set_property  PULLUP      true          [get_ports "DIPSW[2]"]
set_property  PACKAGE_PIN Y10           [get_ports "DIPSW[3]"]
set_property  IOSTANDARD  SSTL135       [get_ports "DIPSW[3]"]
set_property  PULLUP      true          [get_ports "DIPSW[3]"]
set_property  PACKAGE_PIN AC9           [get_ports "DIPSW[4]"]
set_property  IOSTANDARD  SSTL135       [get_ports "DIPSW[4]"]
set_property  PULLUP      true          [get_ports "DIPSW[4]"]
set_property  PACKAGE_PIN AB9           [get_ports "DIPSW[5]"]
set_property  IOSTANDARD  SSTL135       [get_ports "DIPSW[5]"]
set_property  PULLUP      true          [get_ports "DIPSW[5]"]
set_property  PACKAGE_PIN AB8           [get_ports "DIPSW[6]"]
set_property  IOSTANDARD  SSTL135       [get_ports "DIPSW[6]"]
set_property  PULLUP      true          [get_ports "DIPSW[6]"]
set_property  PACKAGE_PIN AA8           [get_ports "DIPSW[7]"]
set_property  IOSTANDARD  SSTL135       [get_ports "DIPSW[7]"]
set_property  PULLUP      true          [get_ports "DIPSW[7]"]

set_property PACKAGE_PIN T27 [get_ports {TESTPIN[0]}]
set_property IOSTANDARD LVCMOS33 [get_ports {TESTPIN[0]}]
set_property PACKAGE_PIN T26 [get_ports {TESTPIN[1]}]
set_property IOSTANDARD LVCMOS33 [get_ports {TESTPIN[1]}]
set_property PACKAGE_PIN T28 [get_ports {TESTPIN[2]}]
set_property IOSTANDARD LVCMOS33 [get_ports {TESTPIN[2]}]
set_property PACKAGE_PIN R28 [get_ports {TESTPIN[3]}]
set_property IOSTANDARD LVCMOS33 [get_ports {TESTPIN[3]}]

# RED
set_property PACKAGE_PIN V29 [get_ports RLED_B]
set_property IOSTANDARD LVCMOS33 [get_ports RLED_B]
# GREEN
set_property PACKAGE_PIN P28 [get_ports GLED_B]
set_property IOSTANDARD LVCMOS33 [get_ports GLED_B]
# BLUE
set_property PACKAGE_PIN V30 [get_ports BLED_B]
set_property IOSTANDARD LVCMOS33 [get_ports BLED_B]

# LEMO interface

# PMBUS
set_property PACKAGE_PIN R30 [get_ports FPGA4_SCL]
set_property IOSTANDARD LVCMOS33 [get_ports FPGA4_SCL]
set_property PACKAGE_PIN T30 [get_ports FPGA4_SDA]
